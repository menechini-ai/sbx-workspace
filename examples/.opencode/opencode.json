{
  "$schema": "https://opencode.ai/config.json",
  "env": {
    "ANTHROPIC_BASE_URL": "http://localhost:20128/v1",
    "BASH_DEFAULT_TIMEOUT_MS": "1800000",
    "BASH_MAX_TIMEOUT_MS": "7200000"
  },
  "provider": {
    "anthropic": {
      "options": {
        "baseURL": "http://localhost:20128/v1",
        "apiKey": "{env:ANTHROPIC_API_KEY}"
      },
      "models": {
        "claude-opus-5": {
          "name": "claude-opus-5"
        },
        "claude-sonnet-5": {
          "name": "claude-sonnet-5"
        }
      }
    }
  },
  "model": "anthropic/claude-opus-5",
  "small_model": "anthropic/claude-sonnet-5",
  "permission": {
    "bash": {
      "npx tsc *": "allow",
      "*": "ask"
    }
  },
  "mcp": {
    "ai-memory": {
      "type": "remote",
      "url": "http://192.168.1.20:49374/mcp",
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {file:.env:AI_MEMORY_AUTH_TOKEN}",
        "Host": "localhost:49374"
      }
    }
  },
  "plugin": ["opencode-superpowers", "opencode-frontend-design"]
}
