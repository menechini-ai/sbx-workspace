# ============================================================
# OmniRoute — Environment Variables (EXEMPLO)
# Copie para .env e ajuste conforme necessário.
# ============================================================

TZ=America/Sao_Paulo

# ── Ports ──
OMNIROUTE_PORT_DASHBOARD=20228
OMNIROUTE_PORT_API=20229
OMNIROUTE_REDIS_PORT=6379

# ── Secrets (gere com: openssl rand -base64 48 / openssl rand -hex 32) ──
OMNIROUTE_JWT_SECRET=
OMNIROUTE_API_KEY_SECRET=
OMNIROUTE_INITIAL_PASSWORD=123456

# ── Image Tag ──
OMNIROUTER_TAG=latest
