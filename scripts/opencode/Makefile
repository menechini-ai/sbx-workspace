COMPOSE := docker compose --env-file ../../.env
GIT_NAME := $(shell git config user.name 2>/dev/null || echo "Agent")
GIT_EMAIL := $(shell git config user.email 2>/dev/null || echo "agent@local")
OPENCODE_WORKSPACE_VOLUME ?= ../../workspace:/workspace
OPENCODE_GITCONFIG_VOLUME ?= ~/.gitconfig:/root/.gitconfig:ro

.PHONY: up down run logs clean

up:
	OPENCODE_WORKSPACE_VOLUME=$(OPENCODE_WORKSPACE_VOLUME) OPENCODE_GITCONFIG_VOLUME=$(OPENCODE_GITCONFIG_VOLUME) $(COMPOSE) up -d  --remove-orphans

run:
	@echo "Iniciando OpenCode..."
	@GIT_AUTHOR_NAME="$(GIT_NAME)" \
	GIT_AUTHOR_EMAIL="$(GIT_EMAIL)" \
	GIT_COMMITTER_NAME="$(GIT_NAME)" \
	GIT_COMMITTER_EMAIL="$(GIT_EMAIL)" \
	OPENCODE_WORKSPACE_VOLUME=$(OPENCODE_WORKSPACE_VOLUME) OPENCODE_GITCONFIG_VOLUME=$(OPENCODE_GITCONFIG_VOLUME) $(COMPOSE) run --rm opencode

down:
	OPENCODE_WORKSPACE_VOLUME=$(OPENCODE_WORKSPACE_VOLUME) OPENCODE_GITCONFIG_VOLUME=$(OPENCODE_GITCONFIG_VOLUME) $(COMPOSE) down

logs:
	OPENCODE_WORKSPACE_VOLUME=$(OPENCODE_WORKSPACE_VOLUME) OPENCODE_GITCONFIG_VOLUME=$(OPENCODE_GITCONFIG_VOLUME) $(COMPOSE) logs -f

clean:
	OPENCODE_WORKSPACE_VOLUME=$(OPENCODE_WORKSPACE_VOLUME) OPENCODE_GITCONFIG_VOLUME=$(OPENCODE_GITCONFIG_VOLUME) $(COMPOSE) down -v
